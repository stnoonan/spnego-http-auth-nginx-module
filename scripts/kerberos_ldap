test_path()
{
	SUBURL="$1"
	EXPECT1="$2"
	EXPECT2="$3"

	printf "curl %s, no negotiate: http status (expect %s)=" "${SUBURL}" "${EXPECT1}"
	rm -f "${CURL_OUTPUT}"
	CODE="$($CURL_NONEGOTIATE -w "%{http_code}" "http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "$CODE" = "${EXPECT1}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then
			echo "HTTP body:"
			cat "${CURL_OUTPUT}"
			echo ""
		fi
	fi

	printf "curl %s, negotiate: http status (expect %s)=" "${SUBURL}" "${EXPECT2}"
	rm -f "${CURL_OUTPUT}"
	CODE="$($CURL_NEGOTIATE -w "%{http_code}" "http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "$CODE" = "${EXPECT2}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then
			echo "HTTP body:"
			cat "${CURL_OUTPUT}"
			echo ""
		fi
	fi
}

test_basic()
{
	SUBURL="$1"
	EXPECT1="$2"
	EXPECT2="$3"

	printf "curl %s, incorrect basic auth: http status (expect %s)=" "${SUBURL}" "${EXPECT1}"
	rm -f "${CURL_OUTPUT}"
	CODE="$($CURL_NONEGOTIATE -u "bob:InVaLiD" -w "%{http_code}" "http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "$CODE" = "${EXPECT1}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then
			echo "HTTP body:"
			cat "${CURL_OUTPUT}"
			echo ""
		fi
	fi

	printf "curl %s, basic auth: http status (expect %s)=" "${SUBURL}" "${EXPECT2}"
	rm -f "${CURL_OUTPUT}"
	CODE="$($CURL_NONEGOTIATE -u "bob:${KRB_BOB_PW}" -w "%{http_code}" "http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "$CODE" = "${EXPECT2}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then
			echo "HTTP body:"
			cat "${CURL_OUTPUT}"
			echo ""
		fi
	fi

}

test_https_path()
{
	SUBURL="$1"
	EXPECT1="$2"
	EXPECT2="$3"

	printf "curl https://%s:%s/%s, no negotiate: http status (expect %s)=" \
		"${TEST_HOST_FQDN}" "${HTTPS_PORT}" "${SUBURL}" "${EXPECT1}"
	rm -f "${CURL_OUTPUT}"
	CODE="$($CURL_HTTPS_NONEGOTIATE -w "%{http_code}" \
		"https://${TEST_HOST_FQDN}:${HTTPS_PORT}/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "$CODE" = "${EXPECT1}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then
			echo "HTTP body:"
			cat "${CURL_OUTPUT}"
			echo ""
		fi
	fi

	printf "curl https://%s:%s/%s, negotiate: http status (expect %s)=" \
		"${TEST_HOST_FQDN}" "${HTTPS_PORT}" "${SUBURL}" "${EXPECT2}"
	rm -f "${CURL_OUTPUT}"
	CODE="$($CURL_HTTPS_NEGOTIATE -w "%{http_code}" \
		"https://${TEST_HOST_FQDN}:${HTTPS_PORT}/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "$CODE" = "${EXPECT2}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then
			echo "HTTP body:"
			cat "${CURL_OUTPUT}"
			echo ""
		fi
	fi
}

curl_supports_channel_binding()
{
	curl --version | grep -q OpenSSL || return 1
	set -- $(curl --version | head -1 | awk '{print $2}' | tr '.' ' ')
	CMAJ="${1:-0}" CMIN="${2:-0}"
	[ "${CMAJ}" -gt 8 ] && return 0
	[ "${CMAJ}" -eq 8 ] && [ "${CMIN}" -ge 10 ] && return 0
	return 1
}

test_ldapwhoami()
{
	LDAP_EXPECTED="dn:uid=${1},cn=gss-spnego,cn=auth"

	printf "Result of ldapwhoami via delegation ... "
	if [ -e "${CURL_OUTPUT}" ]; then
		LDAP_WHOAMI="$(cat "${CURL_OUTPUT}")"
		if [ "${LDAP_WHOAMI}" != "${LDAP_EXPECTED}" ]; then
			printf "%s != %s ... " "${LDAP_WHOAMI}" "${LDAP_EXPECTED}"
			EX=1
			echo "FAILED"
		else
			printf "%s ... " "${LDAP_WHOAMI}"
			echo "OK"
		fi
	else
		EX=1
		echo "FAILED"
	fi
}

curl_transfer_ok()
{
	[ "$1" -eq 0 ] || [ "$1" -eq 22 ]
}

# Curl records every response, so only the final response supplies the headers.
last_response_headers()
{
	awk '/^HTTP\//{b=""} {sub(/\r$/, ""); b=b $0 "\n"} END{printf "%s", b}' "$1"
}

test_ccache_header()
{
	SUBURL="$1"
	EXPECT_CCACHE="$2"
	EXPECT_COPY="${3:-}"
	TMPHEADERS="$(mktemp)"

	printf "curl %s, negotiate: 200 with expected cache=" "${SUBURL}"
	rm -f "${CURL_OUTPUT}"
	CURL_RC=0
	CODE="$($CURL_NEGOTIATE -D "${TMPHEADERS}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:${4:-8080}/${SUBURL}")" || CURL_RC=$?
	HEADERS="$(last_response_headers "${TMPHEADERS}")"
	if curl_transfer_ok "${CURL_RC}" && [ "${CODE}" = "200" ] \
		&& printf '%s\n' "${HEADERS}" | grep -Eqi "${EXPECT_CCACHE}" \
		&& { [ -z "${EXPECT_COPY}" ] || printf '%s\n' "${HEADERS}" | grep -Fqxi "${EXPECT_COPY}"; }; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
	rm -f "${TMPHEADERS}"
}

test_ccache_after_412()
{
	SUBURL="$1"
	EXPECT_CCACHE="${2:-present}"
	TMPHEADERS="$(mktemp)"

	printf "curl %s, negotiate, failed If-Match: 412 with cache %s=" "${SUBURL}" "${EXPECT_CCACHE}"
	rm -f "${CURL_OUTPUT}"
	CURL_RC=0
	CODE="$($CURL_NEGOTIATE -H 'If-Match: "x"' -D "${TMPHEADERS}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || CURL_RC=$?
	HEADERS="$(last_response_headers "${TMPHEADERS}")"
	if curl_transfer_ok "${CURL_RC}" && [ "${CODE}" = "412" ] \
		&& { if [ "${EXPECT_CCACHE}" = present ]; then
			printf '%s\n' "${HEADERS}" | grep -Eqi '^X-Ccache: FILE:[^[:space:]]+$'
		else
			! printf '%s\n' "${HEADERS}" | grep -qi '^X-Ccache:'
		fi; }; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
	rm -f "${TMPHEADERS}"
}

test_negotiate_token()
{
	SUBURL="$1"
	TMPHEADERS="$(mktemp)"

	printf "curl %s, negotiate: WWW-Authenticate token in 200=" "${SUBURL}"
	rm -f "${CURL_OUTPUT}"
	$CURL_NEGOTIATE -D "${TMPHEADERS}" -o "${CURL_OUTPUT}" \
		"http://${TEST_HOST_FQDN}:8080/${SUBURL}" || true

	# -D captures headers from all responses (401 then 200); the 401 has
	# "Negotiate" with no token, the 200 should have "Negotiate <token>".
	# Match only lines that have at least one base64 character after the space.
	if grep -qi "^WWW-Authenticate: Negotiate [A-Za-z0-9+/]" "${TMPHEADERS}"; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
	rm -f "${TMPHEADERS}"
}


# Base64 alone does not identify a SPNEGO reply token.
spnego_reply_tokens()
{
	DECODED_TOKEN="$(mktemp)" || return 1
	TOKEN_RESULT=0
	for REPLY_TOKEN in $1; do
		if ! printf '%s' "${REPLY_TOKEN}" | base64 -d > "${DECODED_TOKEN}" 2>/dev/null; then
			TOKEN_RESULT=1
			break
		fi
		case "$(od -An -tx1 -N1 "${DECODED_TOKEN}" | tr -d ' \n')" in
			a1|60) ;;
			*) TOKEN_RESULT=1; break ;;
		esac
	done
	rm -f "${DECODED_TOKEN}"
	return "${TOKEN_RESULT}"
}

# Reject valid base64 without SPNEGO framing and a reply with invalid base64.
if spnego_reply_tokens AAAA || spnego_reply_tokens oQA; then
	die
fi

test_redirect_token()
{
	SUBURL="$1"
	EXPECT="${2:-200}"
	EXPECT_TOKEN="${3:-present}"
	TMPHEADERS="$(mktemp)"

	printf "curl %s, negotiate: WWW-Authenticate token %s in %s=" \
		"${SUBURL}" "${EXPECT_TOKEN}" "${EXPECT}"
	rm -f "${CURL_OUTPUT}"
	CURL_RC=0
	CODE="$($CURL_NEGOTIATE -D "${TMPHEADERS}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || CURL_RC=$?

	if curl_transfer_ok "${CURL_RC}" && [ "${CODE}" = "${EXPECT}" ] \
		&& TOKEN_VALUES="$(awk -v expected="${EXPECT_TOKEN}" -v marker="${4:-}" '
		/^HTTP\// { token = 0; values = ""; malformed = 0; challenge = 0; found = (marker == "") }
		{ line = $0; sub(/\r$/, "", line)
		  if (line == marker) found = 1
		  original = line
		  line = tolower(line)
		  if (line ~ /^www-authenticate: negotiate[ \t]+[^ \t]/) {
		      value = line
		      sub(/^www-authenticate: negotiate[ \t]+/, "", value)
		      sub(/[ \t]+$/, "", value)
		      if (value ~ /^[a-z0-9+\/]+(=|==)?$/ && length(value) % 4 == 0)
		          { token = 1; sub(/^[^:]+: [^ \t]+[ \t]+/, "", original);
		            sub(/[ \t]+$/, "", original); values = values original "\n" }
		      else
		          malformed = 1
		  }
		  if (line ~ /^www-authenticate: (basic|negotiate[ \t]*$)/) challenge = 1 }
		END { if (malformed || !found || token != (expected == "present") || (expected == "present" && challenge)) exit 1; printf "%s", values }
	' "${TMPHEADERS}")" && spnego_reply_tokens "${TOKEN_VALUES}"; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
	rm -f "${TMPHEADERS}"
}


test_redirect_challenge()
{
	SUBURL="$1"
	TMPHEADERS="$(mktemp)"
	printf "curl %s, negotiate: 401 with %s challenge=" "${SUBURL}" "$2"
	CURL_RC=0
	CODE="$($CURL_NEGOTIATE -D "${TMPHEADERS}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:8080/${SUBURL}")" || CURL_RC=$?
	if curl_transfer_ok "${CURL_RC}" && [ "${CODE}" = 401 ] \
		&& awk -v expected="$2" -v realm="${KERBEROS_REALM}" '
		/^HTTP\// { found = 0; extra = 0 }
		{ line = tolower($0)
		  sub(/\r$/, "", line)
		  if (line !~ /^www-authenticate:/) next
		  if (expected == "Basic")
		      wanted = "www-authenticate: basic realm=\"" tolower(realm) "\", charset=\"utf-8\""
		  else
		      wanted = "www-authenticate: negotiate"
		  if (line == wanted && expected == "Basic") {
		      split($0, quoted, "\"")
		      if (quoted[2] != realm) extra = 1
		  }
		  if (line == wanted) found = 1
		  else extra = 1 }
		END { exit !(found && !extra) }
	' "${TMPHEADERS}"; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
	rm -f "${TMPHEADERS}"
}


# SSI looks up variables by name. A separate configuration keeps krb5_cc_name
# without indexed storage, which configuration references would allocate.
printf "Creating nginx site for unindexed variable reads ... "
cp /etc/nginx/sites-available/kerberos /tmp/kerberos-indexed.conf || die
cat <<EOF > /etc/nginx/sites-available/kerberos || die
server {
	listen 8080;
	server_name ${TEST_HOST_FQDN};
	root /var/www/kerberos;
	ssi on;
	location = /unindexed.html {
		auth_gss off;
	}
	location = /unindexed_login.html {
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
	}
}
EOF
printf 'cache:[<!--#echo var="krb5_cc_name" encoding="none" -->]\n' > /var/www/kerberos/unindexed.html || die
cp /var/www/kerberos/unindexed.html /var/www/kerberos/unindexed_login.html || die
systemctl restart nginx || die
echo "OK"
printf "Checking configuration has no indexed krb5_cc_name reference ... "
if grep -RFq '$krb5_cc_name' /etc/nginx/nginx.conf \
	/etc/nginx/modules-enabled /etc/nginx/conf.d /etc/nginx/sites-enabled; then
	die
else
	[ "$?" -eq 1 ] || die
fi
echo "OK"
kinit -kt krb5.alice.keytab alice || die
for SSI_PATH in unindexed.html unindexed_login.html; do
	SSI_RC=0
	SSI_CODE="$($CURL_NEGOTIATE -w '%{http_code}' \
		"http://${TEST_HOST_FQDN}:8080/${SSI_PATH}")" || SSI_RC=$?
	printf 'SSI %s: rc=%s status=%s body=' "${SSI_PATH}" "${SSI_RC}" "${SSI_CODE}"
	cat "${CURL_OUTPUT}"
	printf "SSI %s: empty cache body ... " "${SSI_PATH}"
	if [ "${SSI_RC}" -eq 0 ] && [ "${SSI_CODE}" = 200 ] &&
		[ "$(cat "${CURL_OUTPUT}")" = 'cache:[]' ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
done
printf "Restoring nginx site with indexed variable reads ... "
mv /tmp/kerberos-indexed.conf /etc/nginx/sites-available/kerberos || die
systemctl restart nginx || die
echo "OK"


