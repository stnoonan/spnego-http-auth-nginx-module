			auth_gss_authorized_principal bob@${KERBEROS_REALM};
			auth_gss_map_to_local on;
			index /fallback.php;
		}
		location /redirect/different/ {
			auth_gss_force_realm on;
		}
		location /redirect/different-basic/ {
			auth_gss_format_full off;
			auth_gss_authorized_principal alice;
			index /fallback.php;
		}
		location /redirect/denied/ {
			index /fallback.php;
		}
		location /redirect/denied-before/ {
			auth_gss_authorized_principal bob@${KERBEROS_REALM};
			error_page 403 = /auth.php;
		}
		location /redirect/named/ {
			try_files \$uri @redirect_auth;
		}
		location /redirect/cache/ {
			auth_gss_allow_basic_fallback on;
			auth_gss_authorized_principal bob@${KERBEROS_REALM};
			auth_gss_delegate_credentials on;
			index /redirect/cache_denied.php;
		}
		location = /redirect/cache_denied.php {
			include fastcgi_params;
			fastcgi_param SCRIPT_FILENAME /var/www/kerberos/cache_denied.php;
			fastcgi_pass unix:/run/php/php-fpm.sock;
			satisfy any;
			allow all;
			auth_gss_allow_basic_fallback on;
			auth_gss_delegate_credentials on;
			fastcgi_param KRB5CCNAME \$krb5_cc_name;
		}
$(redirect_settings_locations redirect)
		location /redirect/header-same/ {
			index /header_bogus.php;
		}
		location /redirect/via-public/ {
			index /redirect/via-public/next;
			location = /redirect/via-public/next {
				auth_gss off;
				error_page 418 = /auth.php;
				return 418;
			}
		}
		location /redirect/error-ok/ {
			error_page 404 = /auth.php;
		}
		location /redirect/relative/ {
			index index.html;
		}
	}

	location @redirect_auth {
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
		auth_gss_authorized_principal alice@${KERBEROS_REALM};
		auth_gss_format_full on;
		include fastcgi_params;
		fastcgi_param SCRIPT_FILENAME /var/www/kerberos/noauth.php;
		fastcgi_pass unix:/run/php/php-fpm.sock;
	}

	# A filter finishing a response clears the module context.
	location = /static_ccache {
		alias /var/www/kerberos/satisfyany;
$(delegation_settings alice)
		add_header X-Ccache "\$krb5_cc_name" always;
	}

	location /static_ccache_redirect/ {
$(delegation_settings alice)
		index /static_ccache;
	}

	location /static_ccache_denied/ {
$(delegation_settings alice)
		index /static_ccache_refused;
	}

	location = /static_ccache_refused {
		alias /var/www/kerberos/satisfyany;
		satisfy any;
		allow all;
$(delegation_settings bob)
		add_header X-Ccache "\$krb5_cc_name" always;
	}

}

